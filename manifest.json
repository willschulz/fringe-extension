{
  "manifest_version": 3,
  "name": "Fringe Detector (Alpha)",
  "version": "0.2.0",
  "description": "Adds experimental, related public-opinion survey context to posts on X/Twitter, Bluesky, and Reddit.",

  "permissions": ["storage"],
  "host_permissions": [
    "https://demoscope-api.willschulz.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://x.com/*",
        "*://bsky.app/*",
        "*://www.reddit.com/*",
        "*://reddit.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["badge.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Fringe Detector pilot settings",
    "default_popup": "popup.html"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
